{
  "name": "londontraffic",
  "version": "0.1.0",
  "description": "National modelled car and heavy vehicle AADT estimates, served from the CSIS pipeline. A subset of the csis-dashboard codebase.",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "npm run check && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "type": "module",
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.49.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tailwindcss/vite": "^4.1.18",
    "svelte": "^5.46.1",
    "svelte-check": "^4.3.5",
    "tailwindcss": "^4.1.18",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  },
  "dependencies": {
    "lucide-svelte": "^0.562.0",
    "maplibre-gl": "^5.15.0",
    "pmtiles": "^4.4.0",
    "svelte-maplibre-gl": "^1.0.3"
  }
}
